{
  "name": "agentwall",
  "version": "0.1.0",
  "description": "Agentwall: provenance-aware policy enforcement for agent egress, tools, content, and approvals",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "onboard": "ts-node src/onboarding.ts",
    "uninstall:system": "bash ./scripts/agentwall-uninstall.sh",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:security-regression": "node scripts/security-regression.js",
    "lint": "tsc --noEmit",
    "cli": "node dist/cli.js",
    "init": "node dist/cli.js init",
    "doctor": "node dist/cli.js doctor",
    "verify:live": "bash ./scripts/verify-live.sh"
  },
  "keywords": [
    "agent",
    "firewall",
    "agentwall",
    "control-plane",
    "ai-safety"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "fastify": "5.11.0",
    "js-yaml": "^4.1.0",
    "pino": "^8.19.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.5",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "setupFiles": [
      "<rootDir>/tests/setup-env.ts"
    ]
  },
  "bin": {
    "agentwall": "dist/cli.js"
  },
  "files": [
    "dist/",
    "public/",
    "examples/",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "SECURITY.md"
  ]
}
