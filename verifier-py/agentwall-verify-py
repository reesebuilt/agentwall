#!/usr/bin/env python3
"""Run the verifier straight from a checkout, with no install step.

The conformance harness runs each case from inside a temporary copy of it, so
the verifier cannot rely on the working directory to find its own package. It
adds the directory this script lives in and nothing else.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from agentwall_verify.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
